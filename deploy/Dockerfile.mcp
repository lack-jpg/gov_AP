# =====================================================
# Dockerfile.mcp - MCP Servers + Gateway
# Author: le
# Date: 2026/8/2
# Version: 0.1
# Task: Containerize MCP Gateway + 3 Servers
#
# Usage:
#   docker build -f deploy/Dockerfile.mcp -t gov-agent-mcp:latest .
#   docker run -p 12001:12001 gov-agent-mcp:latest
# =====================================================

FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# P4-4 依赖收敛：mcp.txt 独立精简（gateway JWT + workflow 落库所需），
# 不再硬编码 pip 列表，也不引入 backend 重型依赖
COPY requirements/mcp.txt requirements/mcp.txt
RUN pip install --no-cache-dir --prefix=/install -r requirements/mcp.txt

# ──────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

COPY . .

RUN useradd -m -u 1000 mcpuser \
    && chown -R mcpuser:mcpuser /app
USER mcpuser

EXPOSE 12001 12011 12021 12031

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:12001/health || exit 1

CMD ["python", "-m", "tools.mcp.start_servers"]
