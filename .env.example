# =====================================================
# .env.example - Environment Variables Template
# Author: le
# Date: 2026/7/29
# Version: 0.2
# Task: Template for .env configuration
# =====================================================
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Port convention:
#   Frontend  → 12345
#   FastAPI   → 8002  (default 8000 + 2)
#   MCP       → 12300+ (Gateway 12300, Policy 12301, Material 12302, Workflow 12303)
#   A2A       → 12200+ (Callback 12200, Connector 12201+)
#   DB        → PG 5434, Redis 6480, Milvus 19532 (Windows port exclusion aware)

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=8002

# ── Frontend ──
# 前端开发服务器端口（Vite/Next.js），生产由 Nginx 反代
FRONTEND_PORT=12345

# ── LLM ──
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen2.5-14b-instruct

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=gov_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gov_agent_platform

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6480
REDIS_PASSWORD=

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19532

# ── Embedding ──
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PATH=models/embedding/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=models/reranker/bge-reranker-v2-m3

# ── Intent Classifier ──
INTENT_MODEL_PATH=models/intent/bert-intent

# ── Model Root ──
MODELS_DIR=models

# ── Agent Runtime ──
AGENT_MAX_STEPS=10
AGENT_LOOP_WINDOW=6
AGENT_TIMEOUT=30

# ── MCP (12300+) ──
MCP_GATEWAY_URL=http://localhost:12300

# ── A2A (12200+) ──
A2A_CALLBACK_URL=http://localhost:12200/api/a2a/callback

# ── Security ──
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gov-agent-platform

# ── Logging ──
LOG_LEVEL=INFO
