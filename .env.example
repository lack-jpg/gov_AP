# =====================================================
# .env.example - Environment Variables Template
# Author: le
# Date: 2026/7/29
# Version: 0.1
# Task: Template for .env configuration
# =====================================================
#
# Copy to .env and fill in your values:
#   cp .env.example .env

# LLM
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen2.5-14b-instruct

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gov_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gov_agent_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Agent Runtime
AGENT_MAX_STEPS=10
AGENT_LOOP_WINDOW=6
AGENT_TIMEOUT=30

# MCP
MCP_GATEWAY_URL=http://localhost:8100

# A2A
A2A_CALLBACK_URL=http://localhost:8000/api/a2a/callback

# Security
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gov-agent-platform

# Logging
LOG_LEVEL=INFO
