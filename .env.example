# =====================================================
# .env.example - Environment Variables Template
# Author: le
# Date: 2026/7/29
# Version: 0.2
# Task: Template for .env configuration
# =====================================================
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Port convention（组内 +10 步进，中间留 9 空位）:
#   MCP       → 12001+ (Gateway 12001, Policy 12011, Material 12021, Workflow 12031)
#   A2A       → 12101+ (housing 12101, fund 12111)
#   DB        → 12201+ (Redis 12201, Milvus 12211, Postgres 12221)
#   Frontend  → 12345 (固定)
#   其他       → 12401+ (API 12401, Prometheus 12411, Grafana 12421, Alertmanager 12431)

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=12401

# ── Frontend ──
# 前端开发服务器端口（Vite/Next.js），生产由 Nginx 反代
FRONTEND_PORT=12345

# ── LLM ──
LLM_API_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen2.5-14b-instruct

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=12221
POSTGRES_USER=gov_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gov_agent_platform

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=12201
# 建议设置密码（生产必须强密码；为空则 Redis 无鉴权）
REDIS_PASSWORD=

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=12211

# ── Embedding ──
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_PATH=models/embedding/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=models/reranker/bge-reranker-v2-m3

# ── Intent Classifier ──
INTENT_MODEL_PATH=models/intent/bert-intent

# ── OCR (PaddleOCR) ──
# 空则使用 PaddleOCR 默认模型；填写本地路径则从本地加载
OCR_MODEL_PATH=

# ── NER (BERT-NER) ──
# 空则使用 regex 模式；填写本地路径（如 models/fine_tuned/ner/）则加载 BERT-NER 模型
NER_MODEL_PATH=

# ── Model Root ──
MODELS_DIR=models

# ── Agent Runtime ──
AGENT_MAX_STEPS=10
AGENT_LOOP_WINDOW=6
AGENT_TIMEOUT=30

# ── MCP (12001+) ──
MCP_GATEWAY_URL=http://localhost:12001

# ── A2A (12101+) ──
A2A_CALLBACK_URL=http://localhost:12401/api/a2a/callback
A2A_HOUSING_URL=http://localhost:12101
A2A_FUND_URL=http://localhost:12111
A2A_HMAC_SECRET=

# ── 监控 (12411+) ──
PROMETHEUS_PORT=12411
GRAFANA_PORT=12421
ALERTMANAGER_PORT=12431

# ── Security ──
# 生产必须替换为强随机密钥（如 openssl rand -hex 32）
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gov-agent-platform

# ── Logging ──
LOG_LEVEL=INFO
